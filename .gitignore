# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and credentials
.env
.env.*
!.env.example
*.pem
*.key
secrets.toml
.streamlit/secrets.toml
hf_token*
huggingface_token*

# Local datasets and generated data
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
*.parquet
*.feather
*.sqlite
*.db

# Generated reports and artifacts
/reports/*
!/reports/.gitkeep
/models/*
!/models/.gitkeep
/artifacts/*
!/artifacts/.gitkeep
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx

# Experiment tracking and logs
mlruns/
mlartifacts/
lightning_logs/
logs/
*.log

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
