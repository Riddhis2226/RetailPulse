# Build from repository root:
# docker build -f Dockerfile.f01 -t retailpulse-f01 .
# Run the full batch pipeline with Hugging Face access token supplied at runtime:
# docker run --rm --env HF_TOKEN --mount type=bind,source="$(pwd)/data",target=/app/data --mount type=bind,source="$(pwd)/reports",target=/app/reports retailpulse-f01

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    RETAILPULSE_OUTPUT_DIR=/app/data/processed \
    RETAILPULSE_REPORT_DIR=/app/reports/f01

WORKDIR /app

COPY requirements-f01.txt ./requirements-f01.txt
RUN pip install --upgrade pip && pip install -r requirements-f01.txt

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-deps .

RUN mkdir -p /app/data/processed /app/reports/f01

ENTRYPOINT ["python", "-m", "retailpulse.f01_data_pipeline"]
